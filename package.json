{
  "name": "zerebro",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Zerebro monorepo — ZConnect (parent+teacher), ZKid (student), Zerebro Campus (principal web), Zerebro Admin (admin web). See docs/EDUCATION_AI_TECH_SPEC.md.",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "dev:emulator": "bash scripts/dev-emulator.sh",
    "seed:staging": "pnpm --filter @zerebro/functions seed:staging",
    "grant-role": "pnpm --filter @zerebro/functions grant-role",
    "import:curriculum": "pnpm --filter @zerebro/functions import:curriculum",
    "seed:voice-stories": "pnpm --filter @zerebro/functions seed:voice-stories",
    "seed:reels": "pnpm --filter @zerebro/functions seed:reels",
    "seed:zumi-config": "pnpm --filter @zerebro/functions seed:zumi-config",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/node": "20.19.41"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.5.0"
  }
}
