{
  "name": "@zerebro/shared-firebase",
  "version": "0.0.0",
  "private": true,
  "description": "Firebase Auth + Firestore helpers shared by web (Next.js) and React Native apps. Conditional exports pick the right platform automatically.",
  "main": "./src/index.native.ts",
  "types": "./src/index.native.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "browser": "./src/index.web.ts",
      "default": "./src/index.web.ts"
    },
    "./auth": "./src/auth.ts",
    "./firestore": "./src/firestore.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@zerebro/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
