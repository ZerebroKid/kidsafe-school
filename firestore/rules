rules_version = '2';

// =============================================================================
// MANUAL SMOKE CHECKLIST (P3.4.3) -- run in Firebase Console > Firestore >
// Rules Playground after every meaningful edit to this file. Phase 2 shipped
// without an automated harness; until that's worth investing in (likely
// Phase 6 pre-launch), this is the source of truth for "did I just break
// auth on a deploy?".
//
// For each row: open Rules Playground -> set the location, payload, and
// "Authenticated" with the specified custom-claim shape (e.g. the playground
// lets you simulate sign-in as a particular uid; you'll also need to seed a
// matching users/{uid} doc with the right roles[] in the emulator first).
//
// ---- ALLOW cases (must pass) -----------------------------------------------
//  1. parent reads own child doc                       READ  /children/CHILD_A         as PARENT_A
//  2. child writes own doc with valid locationDiagnostics
//                                                      UPDATE /children/CHILD_A       as CHILD_A (set locationDiagnostics ok=true)
//  3. parent updates allowed child fields              UPDATE /children/CHILD_A       as PARENT_A (lockState.locked=true)
//  4. principal reads own school                       READ  /schools/SCHOOL_A         as PRINCIPAL_A
//  5. teacher reads own class                          READ  /schools/SCHOOL_A/classes/CLASS_A
//                                                                                      as TEACHER_A (teacherIds includes TEACHER_A)
//  6. child reads its own class                        READ  /schools/SCHOOL_A/classes/CLASS_A
//                                                                                      as CHILD_A (children/CHILD_A.classId.classId = CLASS_A)
//  7. admin creates curriculum topic                   CREATE /curriculum/CUR_A/chapters/CH_A/topics/T_A
//                                                                                      as ADMIN_A
//  8. signed-in user reads approved reward             READ  /rewardCatalog/R_A (moderationStatus='approved') as any signed-in user
//  9. user flips own primaryRole (must hold the role)  UPDATE /users/U_A               as U_A  (set primaryRole='teacher' when roles=['parent','teacher'])
// 10. user creates own v2 user doc on first OTP        CREATE /users/U_A               as U_A  ({roles:[],primaryRole:'principal',phone,createdAt})
//
// ---- DENY cases (must fail) ------------------------------------------------
// 11. unauthenticated reads /users/{anything}          READ  /users/U_A               as <signed out>     -- deny
// 12. user adds 'admin' to own roles[]                 UPDATE /users/U_A               as U_A  (diff includes roles)  -- deny
// 13. user sets primaryRole to a role they don't hold  UPDATE /users/U_A               as U_A  (primaryRole='admin' when roles=['parent']) -- deny
// 14. child writes another child's doc                 UPDATE /children/CHILD_B       as CHILD_A  -- deny
// 15. parent edits non-command field on child doc      UPDATE /children/CHILD_A       as PARENT_A (currentLocation modify) -- deny
// 16. teacher reads other teacher's class              READ  /schools/SCHOOL_A/classes/CLASS_B
//                                                                                      as TEACHER_A (NOT in teacherIds) -- deny
// 17. random user writes studyAssignments              CREATE /studyAssignments/X     as any client -- deny  (server-only)
// 17a. teacher reads OWN studyAssignments               READ  /studyAssignments/A      as TEACHER_A (assignedByTeacherUid=TEACHER_A) -- allow
// 17b. teacher reads ANOTHER teacher's studyAssignment  READ  /studyAssignments/B      as TEACHER_A (assignedByTeacherUid=TEACHER_B) -- deny
// 17c. child reads studyAssignment for OWN class        READ  /studyAssignments/A      as CHILD_A (children/CHILD_A.classId.classId == resource.data.classId) -- allow
// 17d. child reads studyAssignment for OTHER class      READ  /studyAssignments/B      as CHILD_A (classId mismatch) -- deny
// 17e. principal reads any studyAssignment in own school READ /studyAssignments/A      as PRINCIPAL_A (resource.data.schoolId == own school) -- allow
// 17f. parent reads studyAssignment via legacy childUid READ  /studyAssignments/A      as PARENT_A (no childUid on doc) -- DENY (P4.11 will revisit)
// 18. random user writes quizAttempts                  CREATE /quizAttempts/X         as any client -- deny  (server-only)
// 19. signed-in user reads pending/draft reward        READ  /rewardCatalog/R_PEND (moderationStatus='pending') as any signed-in -- deny
// 20. parent of one school principal reads another school
//                                                      READ  /schools/SCHOOL_B         as PRINCIPAL_A (principalUid != PRINCIPAL_A) -- deny
// 21. user with empty roles[] sets primaryRole on return login (Phase 2 OTP
//     doc returning after P3 ships)                    UPDATE /users/U_A               as U_A  (primaryRole='principal' when persisted roles=[]) -- allow
//                                                      (bootstrapping branch; the user is still blocked by RoleOnboardingGate until roles[] is non-empty.)
//
// If any row breaks: revert the deploy and dig in. Don't merge rules-only
// changes through the production deploy path without working this list.
// =============================================================================


service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isSelf(uid) {
      return isSignedIn() && myUid() == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // True if the signed-in user is the linked parent of `childUid`.
    function isParentOf(childUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(childUid))
        && userDoc(childUid).data.parentUid == myUid();
    }

    // ---- Role helpers (P3.4.1) -------------------------------------------
    // Read the v2 `roles[]` from the caller's user doc, tolerating un-migrated
    // v1 docs that only have `role: string`. Returns [] when neither field is
    // present so callers don't crash on a missing-doc evaluation path.
    function rolesOfSelf() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(myUid()))
        ? (
            userDoc(myUid()).data.keys().hasAll(['roles'])
              ? userDoc(myUid()).data.roles
              : (userDoc(myUid()).data.keys().hasAll(['role']) ? [userDoc(myUid()).data.role] : [])
          )
        : [];
    }
    function hasRole(role)   { return role in rolesOfSelf(); }
    function isAdmin()       { return hasRole('admin'); }
    function isPrincipal()   { return hasRole('principal'); }
    function isTeacher()     { return hasRole('teacher'); }
    function isParent()      { return hasRole('parent'); }
    // True if caller is the linked parent of `childUid`. Alias of isParentOf
    // kept for symmetry with the rest of the role family + readability at
    // call sites that read better as `isOwnChild(...)`.
    function isOwnChild(childUid) { return isParentOf(childUid); }
    // True if caller is a principal stamped onto `schools/{schoolId}` as
    // `principalUid`. Read via get() rather than a userDoc field so a
    // principal can't escalate by hand-editing their own user doc.
    function belongsToSchool(schoolId) {
      return isPrincipal()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.principalUid == myUid();
    }

    // NOTE — Phase 1.6.2: the v1 `parentOwns(...)` helper + every `_shared`
    // doc-id branch was removed alongside the rest of shared mode. ZConnect
    // now never writes child profiles directly; the linked-child relationship
    // is the only path that grants a parent write access to `children/{uid}`.

    // Fields the parent is allowed to edit on the child's main doc.
    // `childMode` is intentionally NOT in this list anymore (shared-mode-only).
    function parentEditableFields() {
      return ['lockState', 'geofence', 'screenTime', 'schedule', 'pinResetRequest'];
    }

    // Allowed values for `locationDiagnostics.reason`. Keeping this list here (instead of
    // a wildcard string) so a compromised client can't write arbitrary strings that the
    // parent UI then renders as user-facing copy. Mirrors `LocationDiagnosticsReason` in
    // @zerebro/shared-types.
    function allowedLocationDiagReasons() {
      return [
        'fine_permission_missing',
        'background_permission_missing',
        'system_location_off',
        'play_services_unavailable',
        'fg_service_not_running',
        'first_fix_timeout',
        'firestore_write_failing'
      ];
    }

    // Schema-validate `request.resource.data.locationDiagnostics` if present. We accept
    // absent (most writes don't touch this field), and we accept a shape with required
    // (evaluatedAt:number, ok:bool) + optional (reason:enum, hint:string). Anything else is
    // rejected so a hostile client can't bloat the field.
    function locationDiagnosticsValid() {
      return !('locationDiagnostics' in request.resource.data)
        || (
          request.resource.data.locationDiagnostics.keys().hasOnly(['evaluatedAt', 'ok', 'reason', 'hint'])
            && request.resource.data.locationDiagnostics.evaluatedAt is number
            && request.resource.data.locationDiagnostics.ok is bool
            && (
              !('reason' in request.resource.data.locationDiagnostics)
                || request.resource.data.locationDiagnostics.reason in allowedLocationDiagReasons()
            )
            && (
              !('hint' in request.resource.data.locationDiagnostics)
                || (request.resource.data.locationDiagnostics.hint is string
                     && request.resource.data.locationDiagnostics.hint.size() <= 200)
            )
        );
    }

    // users -------------------------------------------------------------------
    match /users/{uid} {
      // Anyone signed in can look up a user by pairing code; we need this so a
      // child can resolve a parent's 6-digit code to a uid. The returned doc
      // only exposes public fields that are safe to read.
      allow read: if isSignedIn();

      // A user can only create / update their own doc. Two shapes are accepted
      // for `create` during the v1 -> v2 cutover so ZKid/ZConnect (which still
      // write the v1 shape via @react-native-firebase) and the new Zerebro
      // Campus/Admin webs (which write the v2 shape via the JS SDK) can both
      // self-onboard without forking the rule.
      //
      //   v1 (legacy, retire after Phase 3 role-switcher):
      //     {role: 'parent'|'child', email: string, createdAt: ts, ...}
      //
      //   v2 (web phone-OTP onboarding, P2.2.3):
      //     {roles: string[], phone|email: string, createdAt: ts}
      //
      // The hasOnly cap on the v2 branch keeps a hostile client from stuffing
      // arbitrary keys into the create payload; the role-switcher in Phase 3
      // will widen it deliberately as new fields land (displayName, etc).
      allow create: if isSelf(uid) && (
        (
          request.resource.data.role in ['parent', 'child']
            && request.resource.data.keys().hasAll(['role', 'email', 'createdAt'])
        )
        || (
          // v2 web/RN shape. Allows the new ZKid/ZConnect ensureUserDoc
          // (which writes BOTH shapes -- v2 roles[] + v1 role legacy alias)
          // AND the pure-v2 web OTP confirm path. Field whitelist is permissive
          // enough to cover everything ensureUserDoc emits today.
          request.resource.data.roles is list
            && request.resource.data.keys().hasAll(['roles', 'createdAt'])
            && request.resource.data.keys().hasOnly([
                 'roles', 'primaryRole', 'role', 'phone', 'email', 'name',
                 'displayName', 'photoURL', 'fcmToken', 'deviceMode', 'createdAt'
               ])
            && (
              ('phone' in request.resource.data && request.resource.data.phone is string)
                || ('email' in request.resource.data && request.resource.data.email is string)
            )
        )
      );

      // P3.4.2 -- role-escalation defence.
      // Self-writes may NEVER touch `roles[]` (only Admin SDK from Cloud
      // Functions can append -- Phase 4's approveTeacher callable, future
      // admin-invite flows, etc).
      //
      // `primaryRole` IS self-writable so the ZConnect RoleSwitcher works,
      // gated to a role already in `roles[]` so a user can't navigate
      // themselves into a role they don't hold. EXCEPTION: when the
      // persisted `roles[]` is empty (Phase 2 web-OTP signups, brand-new
      // accounts awaiting an admin grant), any primaryRole is allowed as
      // a placeholder -- the user is still blocked from every navigator
      // by RoleOnboardingGate until roles[] is non-empty, so the
      // placeholder can't grant access. It just decides which "awaiting
      // approval" copy to show.
      allow update: if isSelf(uid)
        && !('roles' in request.resource.data.diff(resource.data).affectedKeys())
        && (
          !('primaryRole' in request.resource.data.diff(resource.data).affectedKeys())
            || (
              request.resource.data.primaryRole is string
                && (
                  request.resource.data.primaryRole in resource.data.roles
                    || resource.data.roles.size() == 0
                )
            )
        );

      allow delete: if isSelf(uid);
    }

    // children/{childUid} -----------------------------------------------------
    // Main doc: status, lockState, currentLocation, geofence, screenTime...
    match /children/{childUid} {
      allow read: if isSelf(childUid) || isParentOf(childUid);

      // Child can create/update own doc freely (two-device flow -- the only
      // flow that exists post-P1.6). The only shape-check is on
      // `locationDiagnostics` so a compromised child can't write arbitrary
      // banner copy into the parent UI.
      allow create, update: if isSelf(childUid) && locationDiagnosticsValid();

      // Parent can ALSO create the doc if it doesn't exist yet, but only with
      // command fields. This lets a parent set things like `schedule` before
      // the child has finished onboarding (when set+merge implicitly creates
      // the doc).
      allow create: if isParentOf(childUid)
        && request.resource.data.keys().hasOnly(parentEditableFields());

      // Parent can update ONLY the command fields. We enforce this by checking
      // that the diff between old and new only touches allowed keys.
      allow update: if isParentOf(childUid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(parentEditableFields());

      allow delete: if isSelf(childUid);

      // apps subcollection ------------------------------------------------
      match /apps/{packageName} {
        allow read: if isSelf(childUid) || isParentOf(childUid);

        // Child writes app list entries from PackageReceiver.
        allow create, update, delete: if isSelf(childUid);

        // Parent can flip `isBlocked` only.
        allow update: if isParentOf(childUid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isBlocked']);
      }

      // events subcollection (append-only, read by parent) ----------------
      match /events/{eventId} {
        allow read: if isSelf(childUid) || isParentOf(childUid);
        allow create: if isSelf(childUid);
        allow update, delete: if false;
      }

      // usageDaily subcollection -----------------------------------------
      // One doc per child-local-day, id = `YYYY-MM-DD`. Powers the parent's
      // App Usage screen (7-day chart + per-app list).
      match /usageDaily/{day} {
        allow read: if isSelf(childUid) || isParentOf(childUid);

        // Child writes its own usage breakdown. We pin the schema so a
        // misbehaving client can't bloat the doc with extras.
        allow create, update: if isSelf(childUid)
          && request.resource.data.keys().hasOnly(
               ['date', 'totalMins', 'perApp', 'updatedAt']
             );

        // Day docs are append-mostly; only the child can clear them (e.g.
        // when the user signs out and re-pairs).
        allow delete: if isSelf(childUid);
      }
    }

    // =====================================================================
    // EDUCATION collections (P3.4.2)
    //
    // These collections don't exist yet -- Phase 4 creates them. Rules land
    // now so the moment Phase 4 starts writing, the schema is locked. Every
    // sensitive write path goes through a Cloud Function (Admin SDK) which
    // bypasses these rules; rules govern only direct-from-client reads +
    // a handful of carefully-scoped client writes.
    // =====================================================================

    // schools/{schoolId}
    //   Created by admin web (Zerebro Admin) directly. Principal can read
    //   their own school doc to render the dashboard header.
    //
    //   Pending-principal read branch (P4.2.5): a user who has filed a
    //   claimSchool request but is not yet approved still needs to read the
    //   school doc to render the "Waiting for verification" header. We grant
    //   read access if there is a principals/{myUid} doc under this school
    //   -- by construction claimSchool stamps the principalId == caller.uid
    //   so a stranger cannot manufacture this match without first calling
    //   claimSchool with the correct inviteCode.
    match /schools/{schoolId} {
      allow read: if isAdmin()
        || belongsToSchool(schoolId)
        || (isSignedIn()
            && exists(/databases/$(database)/documents/schools/$(schoolId)/principals/$(myUid())));
      allow create, update: if isAdmin();
      // Schools are never deleted from the client; an admin would archive
      // (status: 'archived') instead via an update.
      allow delete: if false;

      // principals subcollection (P4.2)
      //   `claimSchool`, `approvePrincipal`, and `rejectPrincipal` callables
      //   write here via Admin SDK; clients only READ. A user can see their
      //   own pending/active/rejected claim (so the principal-web pending
      //   screen can onSnapshot-flip on approval). Admins see every claim
      //   in the school; the cross-school admin list uses the collection-
      //   group rule below this block.
      match /principals/{principalId} {
        allow read: if isAdmin()
          || belongsToSchool(schoolId)
          || (isSignedIn() && resource.data.userId == myUid());
        allow create, update, delete: if false;
      }

      // classes subcollection
      //   Principal of the school CRUDs classes; teachers assigned to a class
      //   and children rostered to one need read access for assignments + UI.
      match /classes/{classId} {
        allow read: if isAdmin()
          || belongsToSchool(schoolId)
          || (isTeacher() && myUid() in resource.data.teacherIds)
          // Child reads its own class doc to resolve `subjects` for the
          // study mission UI. The child's classId is stamped on
          // children/{ownUid}.classId by P4.4.2's joinSchool callable.
          || (isSignedIn() && exists(/databases/$(database)/documents/children/$(myUid()))
              && get(/databases/$(database)/documents/children/$(myUid())).data.classId.classId == classId);
        allow create, update, delete: if isAdmin() || belongsToSchool(schoolId);

        // subjects subcollection -- same access rules as the parent class.
        match /subjects/{subjectId} {
          allow read: if isAdmin()
            || belongsToSchool(schoolId)
            || (isTeacher() && myUid() in resource.data.teacherIds)
            || (isSignedIn() && exists(/databases/$(database)/documents/children/$(myUid()))
                && get(/databases/$(database)/documents/children/$(myUid())).data.classId.classId == classId);
          allow create, update, delete: if isAdmin() || belongsToSchool(schoolId);
        }
      }

      // teachers subcollection
      //   `requestTeacherJoin` and `approveTeacher` callables write here via
      //   Admin SDK; clients only READ. A teacher can see their own pending /
      //   active record; the principal sees the full roster.
      match /teachers/{teacherId} {
        allow read: if isAdmin()
          || belongsToSchool(schoolId)
          || (isSignedIn() && resource.data.userId == myUid());
        allow create, update, delete: if false;
      }

      // parents subcollection (P4.4)
      //   `joinSchoolAsParent` callable writes here via Admin SDK; clients
      //   only READ. UNLIKE teachers, the principal does NOT get read access
      //   here -- the parents audit list lives in admin web only (decided in
      //   P4.4 plan: principal has no parent-list view). Self-read is allowed
      //   so a parent can subscribe to their own membership doc if needed.
      match /parents/{parentId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource.data.userId == myUid());
        allow create, update, delete: if false;
      }
    }

    // Cross-school collection-group read for `principals/*` (P4.2.7).
    //   Admin web lists every pending principal claim across all schools via
    //   `collectionGroup('principals').where('status','==','pending')`. That
    //   query is evaluated against THIS rule, not the per-school rule above.
    //   We keep the same read predicates as the per-school rule:
    //     - admin sees all
    //     - any signed-in user sees their own claim (so a principal-web
    //       collectionGroup query to "find my pending claim" works without
    //       knowing the schoolId)
    //   Writes are NEVER allowed at any depth -- only Admin SDK callables
    //   may mutate `principals/*` docs.
    match /{path=**}/principals/{principalId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == myUid());
      allow write: if false;
    }

    // Cross-school collection-group read for `teachers/*` (P4.3).
    //   ZConnect's pending screen subscribes to
    //   `collectionGroup('teachers').where('userId','==',myUid).limit(1)` to
    //   find its own join request without knowing the schoolId first. Same
    //   self-read predicate as the principals cross-school rule above.
    //   Writes are NEVER allowed at any depth -- only Admin SDK callables
    //   (`requestTeacherJoin`, `approveTeacher`, `rejectTeacher`) mutate
    //   `teachers/*` docs.
    match /{path=**}/teachers/{teacherId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == myUid());
      allow write: if false;
    }

    // studyAssignments/{id}
    //   Written exclusively by the `assignTopic` callable (Admin SDK).
    //   Reads: assigned teacher, kids in the class, principal of the school.
    //
    //   P4.5.1 -- the document is CLASS-LEVEL: there is no `childUid` field.
    //   The previous P3.4.2 stub gated parent reads on
    //   `isOwnChild(resource.data.childUid)` which would always fail (the
    //   field is undefined). We drop that branch here intentionally; parent
    //   visibility for assignments will be revisited in P4.11 (parent Study
    //   tab), where we'll either:
    //     a) add a `childUid[]` denormalisation for parent-fan-out (heavy), or
    //     b) hydrate the assignment client-side from the child's `classId`.
    //   The parent tab also reads `quizAttempts` which IS filtered by
    //   `assignedByTeacherUid` / `childUid`, so parents still see scores
    //   without needing to read the underlying assignment.
    //
    //   The two remaining read paths cover the MVP:
    //     - teacher self-read: `assignedByTeacherUid == myUid()`
    //     - child class-read: the child's own `children/{uid}.classId.classId`
    //       must equal the assignment's `classId`. Same pattern the class
    //       and subject docs use above.
    //   Principal read for school-wide views ships with `belongsToSchool` if
    //   we add `schoolId` filtering on the principal dashboard query later.
    match /studyAssignments/{id} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.assignedByTeacherUid == myUid())
        || (isSignedIn() && exists(/databases/$(database)/documents/children/$(myUid()))
            && get(/databases/$(database)/documents/children/$(myUid())).data.classId.classId == resource.data.classId)
        || belongsToSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // quizAttempts/{id}
    //   Written exclusively by `submitQuizAttempt` callable (Admin SDK).
    //   Reads: the child who took the quiz, their parent, the assigned
    //   teacher, the principal of the school.
    match /quizAttempts/{id} {
      allow read: if isAdmin()
        || isSelf(resource.data.childUid)
        || (isParent() && isOwnChild(resource.data.childUid))
        || (isTeacher() && resource.data.assignedByTeacherUid == myUid())
        || belongsToSchool(resource.data.schoolId);
      allow create, update, delete: if false;
    }

    // curriculum/{curriculumId}/chapters/{chapterId}/topics/{topicId}
    //   Imported by `scripts/import-curriculum.ts` (Admin SDK). Any signed-in
    //   user can read published topics (kids read in the learn screen,
    //   teachers read in the assign-topic picker, principals read in QA).
    //   We don't filter on `status == 'published'` at the rule level because
    //   the import script publishes atomically.
    match /curriculum/{curriculumId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();

        match /topics/{topicId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isAdmin();
        }
      }
    }

    // rewardCatalog/{id}
    //   Admin curates; the reward-picker trigger reads via Admin SDK so
    //   clients only need read access to render "what could I unlock?"
    //   previews. We gate visibility on moderationStatus so unapproved
    //   drafts don't leak to a kid's preview UI.
    match /rewardCatalog/{id} {
      allow read: if isSignedIn() && resource.data.moderationStatus == 'approved';
      allow create, update, delete: if isAdmin();
    }

    // rewardUnlocks/{id}
    //   Written exclusively by `onQuizAttemptWrite` trigger (Admin SDK).
    //   The child sees their own unlocks, the parent sees their linked
    //   child's unlocks.
    match /rewardUnlocks/{id} {
      allow read: if isAdmin()
        || isSelf(resource.data.childUid)
        || (isParent() && isOwnChild(resource.data.childUid));
      allow create, update, delete: if false;
    }

    // classReports/{classId}/daily/{date}
    //   Written exclusively by the nightly `aggregateClassReports` cron
    //   (Admin SDK). Principal of the school + teachers of the class read.
    match /classReports/{classId} {
      // Top-level doc is currently unused -- the schema is `classId/daily/{date}`.
      // We allow read so a principal's UI can list child dates with a simple
      // collectionGroup-style query if we ever add one.
      allow read: if isAdmin()
        || (isPrincipal() && resource.data.schoolId != null
            && belongsToSchool(resource.data.schoolId))
        || (isTeacher() && resource.data.teacherIds != null
            && myUid() in resource.data.teacherIds);
      allow create, update, delete: if false;

      match /daily/{date} {
        allow read: if isAdmin()
          || (isPrincipal() && resource.data.schoolId != null
              && belongsToSchool(resource.data.schoolId))
          || (isTeacher() && resource.data.teacherIds != null
              && myUid() in resource.data.teacherIds);
        allow create, update, delete: if false;
      }
    }
  }
}
