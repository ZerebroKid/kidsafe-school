rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isSelf(uid) {
      return isSignedIn() && myUid() == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // True if the signed-in user is the linked parent of `childUid`.
    function isParentOf(childUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(childUid))
        && userDoc(childUid).data.parentUid == myUid();
    }

    // True for shared-phone profiles: the doc id is `${parentUid}_shared` AND, when the
    // doc already exists, its `parentUid` field matches the writer. This is what lets a
    // single Firebase user (the parent) act as the author/owner of their own child profile
    // without spinning up a second auth user just to host the data.
    //
    // On CREATE, `resource` is null but `request.resource` carries the about-to-be-written
    // doc — we check the incoming parentUid there. On UPDATE / READ / DELETE we cross-check
    // the stored parentUid so a hostile party can't squat on someone else's child id.
    function parentOwns(childId) {
      return isSignedIn()
        && childId == myUid() + '_shared'
        && (
          resource == null
            ? request.resource.data.parentUid == myUid()
            : resource.data.parentUid == myUid()
        );
    }

    // Fields the parent is allowed to edit on the child's main doc.
    function parentEditableFields() {
      return ['lockState', 'geofence', 'screenTime', 'schedule', 'pinResetRequest', 'childMode'];
    }

    // users -------------------------------------------------------------------
    match /users/{uid} {
      // Anyone signed in can look up a user by pairing code; we need this so a
      // child can resolve a parent's 6-digit code to a uid. The returned doc
      // only exposes public fields that are safe to read.
      allow read: if isSignedIn();

      // A user can only create / update their own doc. Role and parentUid are
      // set at creation; parentUid may also be set by the child during pairing.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['parent', 'child']
        && request.resource.data.keys().hasAll(['role', 'email', 'createdAt']);

      allow update: if isSelf(uid);

      allow delete: if isSelf(uid);
    }

    // children/{childUid} -----------------------------------------------------
    // Main doc: status, lockState, currentLocation, geofence, screenTime...
    match /children/{childUid} {
      allow read: if isSelf(childUid) || isParentOf(childUid) || parentOwns(childUid);

      // Child can create/update own doc freely (legacy two-device flow).
      allow create, update: if isSelf(childUid);

      // Shared-phone profile: parent owns the doc directly.
      allow create, update, delete: if parentOwns(childUid);

      // Parent can ALSO create the doc if it doesn't exist yet, but only with
      // command fields. This lets a parent set things like `schedule` before
      // the child has finished onboarding (when set+merge implicitly creates
      // the doc).
      allow create: if isParentOf(childUid)
        && request.resource.data.keys().hasOnly(parentEditableFields());

      // Parent can update ONLY the command fields. We enforce this by checking
      // that the diff between old and new only touches allowed keys.
      allow update: if isParentOf(childUid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(parentEditableFields());

      allow delete: if isSelf(childUid);

      // apps subcollection ------------------------------------------------
      match /apps/{packageName} {
        allow read: if isSelf(childUid) || isParentOf(childUid) || parentOwns(childUid);

        // Child writes app list entries from PackageReceiver.
        allow create, update, delete: if isSelf(childUid);

        // Shared-phone profile: parent owns the apps directly.
        allow create, update, delete: if parentOwns(childUid);

        // Parent can flip `isBlocked` only.
        allow update: if isParentOf(childUid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isBlocked']);
      }

      // events subcollection (append-only, read by parent) ----------------
      match /events/{eventId} {
        allow read: if isSelf(childUid) || isParentOf(childUid) || parentOwns(childUid);
        allow create: if isSelf(childUid) || parentOwns(childUid);
        allow update, delete: if false;
      }

      // usageDaily subcollection -----------------------------------------
      // One doc per child-local-day, id = `YYYY-MM-DD`. Powers the parent's
      // App Usage screen (7-day chart + per-app list).
      match /usageDaily/{day} {
        allow read: if isSelf(childUid) || isParentOf(childUid) || parentOwns(childUid);

        // Child writes its own usage breakdown. We pin the schema so a
        // misbehaving client can't bloat the doc with extras.
        allow create, update: if isSelf(childUid)
          && request.resource.data.keys().hasOnly(
               ['date', 'totalMins', 'perApp', 'updatedAt']
             );

        // Shared-phone profile: parent owns the usage data directly, same shape.
        allow create, update: if parentOwns(childUid)
          && request.resource.data.keys().hasOnly(
               ['date', 'totalMins', 'perApp', 'updatedAt']
             );

        // Day docs are append-mostly; only the child can clear them (e.g.
        // when the user signs out and re-pairs).
        allow delete: if isSelf(childUid) || parentOwns(childUid);
      }
    }
  }
}
