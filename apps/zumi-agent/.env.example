# LiveKit Cloud project (cloud.livekit.io -> project settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

# Sarvam AI (dashboard.sarvam.ai) -- streaming Hinglish STT (Saaras v3)
SARVAM_API_KEY=sk_xxxxxxxx

# OpenAI -- same key as the Firebase functions use
OPENAI_API_KEY=sk-xxxxxxxx

# Kokoro TTS -- self-hosted Kokoro-FastAPI (fast, free). Start it with:
#   docker run -d --name kokoro-tts --restart unless-stopped \
#     -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
KOKORO_BASE_URL=http://localhost:8880/v1/audio/speech
# Kokoro preset voice (e.g. hf_alpha, af_heart, af_bella, bf_emma)
KOKORO_VOICE=hf_alpha
# OpenRouter hosted Kokoro exists ($0.62/M chars) but generated slower than
# real-time in testing -- keep only as emergency fallback (set KOKORO_BASE_URL
# to https://openrouter.ai/api/v1/audio/speech and provide this key).
OPENROUTER_API_KEY=sk-or-xxxxxxxx

# Firebase Admin: uses Application Default Credentials by default
# (`gcloud auth application-default login`, already set up on this machine).
# Or point at a service-account JSON instead:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_PROJECT_ID=kidsafe-e5eac

# ---- Turn-taking tuning (all optional; defaults shown) ---------------------
# How long the child must be quiet before Zumi treats the turn as finished.
# 0.3-0.5 is the usable band: lower cuts kids off mid-sentence, higher feels
# like Zumi isn't listening.
# ZUMI_ENDPOINT_MIN_DELAY=0.4
# ZUMI_ENDPOINT_MAX_DELAY=2.5
# Silero VAD (local, no network): silence below this never reaches STT.
# ZUMI_VAD_MIN_SILENCE=0.25
# ZUMI_VAD_MIN_SPEECH=0.05
# ZUMI_VAD_ACTIVATION=0.5
# End-of-turn strategy: "inference" = LiveKit's semantic turn detector (knows
# "I went to the..." is unfinished), "vad" = pure silence, fully local.
# ZUMI_TURN_DETECTOR=inference
# Barge-in (child talks over Zumi and she stops). Raise min duration/words if
# classroom noise cuts her off; "off" disables interruptions entirely.
# ZUMI_INTERRUPTIONS=on
# ZUMI_INTERRUPT_MIN_DURATION=0.6
# ZUMI_INTERRUPT_MIN_WORDS=0
# ZUMI_FALSE_INTERRUPT_TIMEOUT=2.0
# Latency target used to flag slow turns in the [perf] logs.
# ZUMI_LATENCY_TARGET=1.5
