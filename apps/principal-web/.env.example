# Copy these six keys into the Vercel project's Environment Variables
# (Project Settings -> Environment Variables) for all three environments
# (Production, Preview, Development). For local dev, copy this file to
# .env.local instead and fill in the values.
#
# Source of values: Firebase Console -> Project settings -> General ->
# Your apps -> Web app. If no web-app registration exists, click
# "Add app -> Web" and skip Firebase Hosting (we deploy on Vercel).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Razorpay (public key only — safe for client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
