# Zerebro Campus -- Firebase Web SDK config
#
# Copy to .env.local (gitignored) and fill in the six values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
#
# If a "Web app" registration does not exist on the project yet, click
# "Add app -> Web" inside the Firebase Console. Skip Firebase Hosting -- we
# deploy to Vercel.
#
# All six are public-by-design (they identify the project, not authorise it)
# and Next.js inlines anything prefixed NEXT_PUBLIC_* into the client bundle.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
