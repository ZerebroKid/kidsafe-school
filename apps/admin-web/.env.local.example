# Zerebro Admin -- Firebase Web SDK config
#
# Copy to .env.local (gitignored) and fill in the six values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
#
# Both Zerebro Admin and Zerebro Campus point at the SAME Firebase project
# (one Firestore for everything); role-based access control lives in the
# `users/{uid}.roles[]` array, enforced by security rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# When true, the callable client connects to the local Functions emulator
# (asia-south1, 127.0.0.1:5001) instead of the deployed functions in
# kidsafe-e5eac. Leave unset / `false` for production builds.
NEXT_PUBLIC_USE_EMULATOR=true
