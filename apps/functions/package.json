{
  "name": "@zerebro/functions",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Firebase Cloud Functions for the Zerebro stack. Hosts admin-side scripts (one-time user migration in Phase 3) and the Phase 4 education callables (assignTopic, approveTeacher, submitQuizAttempt, ...).",
  "main": "dist/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate": "pnpm build && node dist/scripts/oneTimeMigration_v1_to_v2.js",
    "seed:staging": "pnpm build && node dist/scripts/seedStaging.js",
    "grant-role": "pnpm build && node dist/scripts/grantRole.js",
    "import:curriculum": "pnpm build && node dist/scripts/importCurriculum.js",
    "seed:voice-stories": "pnpm build && node dist/scripts/seedVoiceStories.js",
    "aggregate:reports": "pnpm build && node dist/scripts/runAggregateClassReports.js",
    "set-school-grades": "pnpm build && node dist/scripts/setSchoolGrades.js",
    "create:plan": "pnpm build && node dist/scripts/createRazorpayPlan.js",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "razorpay": "^2.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.0"
  }
}
